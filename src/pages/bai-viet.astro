---
// Nhập component StarlightPage để giữ giao diện tổng thể
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

// Nhập hàm getCollection để lấy dữ liệu Markdown
import { getCollection } from 'astro:content';

// Lấy TẤT CẢ các bài viết trong thư mục 'src/content/docs'
const allPosts = await getCollection('docs');
---

<StarlightPage frontmatter={{ title: 'Tất cả bài viết', template: 'splash' }}>
  
  <main class="container">
    
    <!-- Tiêu đề trang -->
    <header class="page-header">
      <h1>Khám phá tất cả bài viết</h1>
      <p>Tổng hợp các bài viết chia sẻ kiến thức về lập trình và công nghệ.</p>
    </header>

    <!-- Khu vực hiển thị toàn bộ bài viết -->
    <section class="all-posts-section">
      <div class="posts-grid">
        
        {/* Lặp qua danh sách toàn bộ bài viết để tạo thẻ HTML động */}
        {allPosts.map(post => (
          <article class="post-card">
            <img src={post.data.thumbnail || "https://via.placeholder.com/400x200"} alt={post.data.title} class="post-img" />
            <div class="post-content">
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-desc">{post.data.description}</p>
              
              {/* Nút đọc bài viết (Sử dụng post.id cho bản Astro mới) */}
              <a href={`/${post.id}/`} class="read-more-btn">Đọc bài viết</a>
            </div>
          </article>
        ))}

      </div>
    </section>

  </main>

  <style>
    /* --- CSS Cơ bản và Reponsive --- */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
    }

    .page-header {
      text-align: center;
      margin-bottom: 50px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--sl-color-hairline);
    }

    .page-header h1 {
      font-size: 2.5rem;
      margin-bottom: 10px;
      color: var(--sl-color-white);
    }

    .page-header p {
      font-size: 1.1rem;
      color: var(--sl-color-gray-3);
    }

    .all-posts-section {
      margin-bottom: 50px;
    }

    /* --- CSS cho Bố cục Dạng Lưới (Grid) --- */
    .posts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 30px;
    }

    /* --- CSS cho Thẻ Bài viết (Card) giống trang chủ --- */
    .post-card {
      background-color: var(--sl-color-bg-nav);
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
      transition: transform 0.3s;
      display: flex;
      flex-direction: column;
      border: 1px solid var(--sl-color-hairline);
    }
    
    .post-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 6px 12px rgba(0,0,0,0.15);
    }

    .post-img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }

    .post-content {
      padding: 20px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }

    .post-title {
      font-size: 20px;
      margin-bottom: 10px;
      color: var(--sl-color-white);
    }

    .post-desc {
      font-size: 14px;
      color: var(--sl-color-gray-3);
      margin-bottom: 20px;
      flex-grow: 1;
    }

    .read-more-btn {
      display: inline-block;
      padding: 10px 15px;
      background-color: #007bff;
      color: #fff !important;
      text-decoration: none;
      border-radius: 4px;
      text-align: center;
      transition: background-color 0.3s;
      margin-top: auto;
    }

    .read-more-btn:hover {
      background-color: #0056b3;
    }
  </style>
</StarlightPage>