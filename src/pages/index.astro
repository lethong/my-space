---
// Nhập component của Starlight
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

// Nhập hàm getCollection từ API của Astro để lấy nội dung Markdown
import { getCollection } from 'astro:content';

// Lấy TẤT CẢ các bài viết trong thư mục 'src/content/docs'
const allDocs = await getCollection('docs');

// Lọc ra các bài viết thuộc chủ đề "C# Nâng Cao" (dựa vào tên folder gốc)
const csharpPosts = allDocs.filter(doc => doc.id.startsWith('csharp-nang-cao/'));

// Lọc ra các bài viết thuộc chủ đề "SQL Server"
const sqlPosts = allDocs.filter(doc => doc.id.startsWith('sql-server/'));
---

<StarlightPage frontmatter={{ title: 'Trang Chủ', template: 'splash' }}>
  
  <main class="container">
    
    <!-- === KHU VỰC 1: C# NÂNG CAO === -->
    <section class="category-section">
      <h2 class="section-title">C# Nâng Cao</h2>
      <div class="posts-grid">
        
        {/* Lặp qua danh sách bài viết C# để tạo thẻ HTML động */}
        {csharpPosts.map(post => (
          <article class="post-card">
            {/* Tạm thời dùng ảnh giả, nếu Markdown có thêm trường cover image thì gọi post.data.cover */}
            <img src={post.data.thumbnail || post.data.cover} alt={post.data.title} class="post-img"/>
            <div class="post-content">
              {/* Lấy title từ file Markdown */}
              <h3 class="post-title">{post.data.title}</h3>
              {/* Lấy description từ file Markdown */}
              <p class="post-desc">{post.data.description}</p>
              {/* post.slug tự động tạo đường dẫn chuẩn xác đến bài viết */}
              <a href={`/${post.slug || post.id}/`} class="read-more-btn">Đọc bài viết</a>
            </div>
          </article>
        ))}

      </div>
    </section>

    <!-- === KHU VỰC 2: SQL SERVER === -->
    <section class="category-section">
      <h2 class="section-title">SQL Server</h2>
      <div class="posts-grid">
        
        {sqlPosts.map(post => (
          <article class="post-card">
            <img src={post.data.thumbnail || "https://via.placeholder.com/400x200"} alt={post.data.title} class="post-img"/>
            <div class="post-content">
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-desc">{post.data.description}</p>
              <a href={`/${post.slug || post.id}/`} class="read-more-btn">Đọc bài viết</a>
            </div>
          </article>
        ))}

      </div>
    </section>

  </main>

  <style>
    /* Dán toàn bộ đoạn CSS từ câu trả lời trước của tôi vào đây, bắt đầu từ class .container, .category-section, .posts-grid, .post-card... */
    
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }
    .section-title {
      font-size: 28px;
      margin-bottom: 20px;
      border-bottom: 2px solid #007bff;
      display: inline-block;
      padding-bottom: 5px;
    }
    .category-section {
      margin-bottom: 50px;
    }
    .posts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 30px;
    }
    .post-card {
      background-color: #fff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
      transition: transform 0.3s;
      display: flex;
      flex-direction: column;
      border: 1px solid #e5e5e5;
    }
    .post-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 6px 12px rgba(0,0,0,0.1);
    }
    .post-img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }
    .post-content {
      padding: 20px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }
    .post-title {
      font-size: 20px;
      margin-bottom: 10px;
      color: #333;
    }
    .post-desc {
      font-size: 14px;
      color: #666;
      margin-bottom: 20px;
      flex-grow: 1;
    }
    .read-more-btn {
      display: inline-block;
      padding: 10px 15px;
      background-color: #007bff;
      color: #fff;
      text-decoration: none;
      border-radius: 4px;
      text-align: center;
      transition: background-color 0.3s;
      margin-top: auto;
    }
    .read-more-btn:hover {
      background-color: #0056b3;
      color: white;
    }
  </style>

</StarlightPage>