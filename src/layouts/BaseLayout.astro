---
// src/layouts/BaseLayout.astro
// Bạn có thể viết code JavaScript/TypeScript ở đây (Frontmatter)
const { title = 'Trang chủ Astro của tôi' } = Astro.props;
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <!-- Header chung cho toàn bộ trang web -->
    <header>
      <nav>
        <a href="/">Trang chủ</a>
        <a href="/about">Giới thiệu</a>
      </nav>
    </header>

    <main>
      <!-- Thẻ <slot /> là nơi nội dung của trang index.astro sẽ được hiển thị -->
      <slot />
    </main>

    <!-- Footer chung -->
    <footer>
      <p>&copy; 2026 Bản quyền thuộc về tôi.</p>
    </footer>
  </body>
</html>